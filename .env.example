BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую (получают заявки на подтверждение)
ADMIN_IDS=123456789

BRAND=STARS SHOP
# Цена одной звезды в рублях
STAR_PRICE_RUB=1.1
MIN_STARS=50
MAX_STARS=50000
# Наценка к рыночному курсу TON, % (0 = чистый курс)
TON_MARKUP_PERCENT=0
MIN_TON=1
# Бонус пригласившему, % от суммы заказа приглашённого
REF_PERCENT=3

# Реквизиты для оплаты (HTML разрешён)
# Общие реквизиты (если не заданы отдельные ниже)
PAY_DETAILS=Карта: <code>0000 0000 0000 0000</code>\nПолучатель: Имя Ф.
# Отдельные реквизиты для разделов (необязательно)
PAY_DETAILS_STARS=Карта для звёзд: <code>1111 1111 1111 1111</code>
PAY_DETAILS_TON=СБП для TON: <code>+7 900 000-00-00</code>
# Оплата звёзд криптой (оставь пустым, чтобы выключить способ)
PAY_CRYPTO_USDT=USDT (TRC20): <code>T...</code>
PAY_CRYPTO_TON=TON: <code>UQ...</code>\nКомментарий: <code>shop</code>
SUPPORT_URL=https://t.me/your_support
REVIEWS_URL=https://t.me/your_reviews

DB_PATH=data/shop.db
