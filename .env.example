BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую
ADMIN_IDS=123456789

BRAND=SwiftEx
# Публичный URL Mini App (https://...), нужен для кнопки в боте
WEBAPP_URL=https://your-domain.example

# Курсы в рублях (можно менять командой /rate)
USDT_RATE_RUB=96
TON_RATE_RUB=550
MIN_USDT=32
MIN_TON=1

# Реферальный бонус за 1 успешный обмен реферала
REF_BONUS_RUB=50
# Компенсация, если заявка дольше 15 минут
DELAY_COMPENSATION_RUB=50
ORDER_COOLDOWN_SEC=900
ORDER_SLA_SEC=900

# Реквизиты для приёма крипты
WALLET_USDT_TRC20=T...
WALLET_USDT_TON=UQ...
WALLET_TON=UQ...
SUPPORT_URL=https://t.me/your_support

# Призы топа недели (1-е, 2-е, 3-е…)
WEEKLY_PRIZES=3000,2000,1000

DB_PATH=data/exchange.db
PORT=8080
